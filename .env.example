# ---------------------------------------------------------------------------
# Required — Supabase project
# Project Settings → API in your Supabase dashboard.
# The anon key is public and RLS-scoped; it is safe in the browser.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Optional — your own backend
#
# Everything that needs a secret goes through this URL: n8n workflows, model
# calls (Anthropic / OpenAI / Ollama), and the vector store. The backend holds
# those credentials; the browser never sees them.
#
# Leave unset and the app runs on its rule-based engine — fully functional,
# nothing external required.
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://api.tudominio.com

# Which model provider the backend should use: anthropic | openai | ollama | rules
# Ignored unless VITE_API_BASE_URL is set.
# VITE_AI_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# NEVER put these in this file or any VITE_ variable — anything prefixed with
# VITE_ is bundled into the JavaScript your users download:
#
#   SUPABASE_SERVICE_ROLE_KEY, N8N_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY,
#   WHATSAPP_TOKEN, STRIPE_SECRET_KEY, QDRANT_API_KEY
#
# They belong in your backend's environment only.
# ---------------------------------------------------------------------------
